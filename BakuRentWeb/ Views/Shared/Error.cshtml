@model ErrorViewModel

@{
    ViewData["Title"] = "Xəta";
}

<div class="container mt-4">
    <h2 class="text-danger">Xəta baş verdi</h2>
    <p>Sorğunu emal edərkən xəta baş verdi.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>
